# Soteria Dialogue — environment configuration
# Copy this file to .env and fill in the values.
# Never commit the real .env file.

# Database (PostgreSQL)
# Local dev: postgresql://user:pass@localhost:5432/soteria
# Render: provided automatically when you link the database to the web service
DATABASE_URL="postgresql://user:pass@localhost:5432/soteria"

# NextAuth.js
# Generate a strong secret with: `openssl rand -base64 32`
NEXTAUTH_SECRET="dev-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# z-ai-web-dev-sdk
# Configuration is auto-loaded from ~/.z-ai-config or ./.z-ai-config
# ZAI_API_KEY="your-api-key"
