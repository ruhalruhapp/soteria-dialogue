# Soteria Dialogue — local and Vercel environment variables
# Never commit real credentials. Configure these in Vercel Project Settings.

# Neon PostgreSQL: pooled connection for the app, direct connection for Prisma CLI.
# DATABASE_URL uses the Neon hostname containing -pooler.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DB?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require"

# Auth.js — generate a unique random secret of at least 32 characters.
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Resend — use a sender address on a domain verified in Resend.
AUTH_RESEND_KEY="re_..."
EMAIL_FROM="Soteria Dialogue <login@your-verified-domain.example>"

# Optional canonical production URL.
AUTH_URL="https://your-production-domain.example"
